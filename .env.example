# Mirror
DATABASE_URL=
MIRROR_BACKEND=local
MIRROR_HOST=0.0.0.0
MIRROR_PORT=8844

# Auth
MIRROR_ADMIN_TOKEN=sk-change-me
MIRROR_API_KEY=sk-workspace-token
MIRROR_TENANT_KEYS_PATH=tenant_keys.json
MIRROR_INTERNAL_AGENTS=

# Embeddings: openai, local-onnx, local
MIRROR_EMBED_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key

# Optional SOS integration. Leave unset for standalone mode.
# SOS_BUS_URL=
# MIRROR_SOS_SUBSCRIBER_MODULE=mirror_sos_subscriber
